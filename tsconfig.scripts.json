{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist-scripts",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/core/**/*.ts",
    "src/constants/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components",
    "src/hooks",
    "src/store",
    "app"
  ]
}
